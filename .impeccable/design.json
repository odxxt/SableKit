  "narrative": {
    "northStar": "Smoky black, neutral charcoal and white",
    "overview": "SableKit uses the owner's chosen smoky black, neutral charcoal and white direction for a modern, enterprise-quality desktop utility. Subtle Raycast influence and the compact pin/search/click-to-act familiarity of SableLatch inform the implementation. Native Segoe UI, quiet metadata, thin outlines and restrained rounded controls keep actions readable.\n\nThis is an extraction of prototype 0.1, implemented directly in WPF without an approved image composition. It records the current code, not a new branding commitment. Tonal layering supplies the dependable structure; native Windows material is an enhancement whose compositor appearance still needs validation.",
    "keyCharacteristics": [
      "Compact controls with clear action labels and quieter supporting text.",
      "Charcoal and white emphasis, with semantic status resources.",
      "Original line geometry and native Windows typography.",
      "Stable action dimensions during running and Copied feedback."
    ],
    "rules": [
      {
        "name": "The Dynamic Role Rule",
        "body": "Use WPF DynamicResource/SetResourceReference role keys for themed UI rather than hardcoded per-control colors.",
        "section": "colors"
      },
      {
        "name": "The Readable Surface Rule",
        "body": "Maintain contrast on the ordinary charcoal/light surface; native material must not be necessary to understand a control.",
        "section": "elevation"
      },
      {
        "name": "The Stable Feedback Rule",
        "body": "Running and Copied feedback retain the action's dimensions and preserve keyboard focus across updates.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the dynamic WPF resource roles so theme changes reach controls.",
      "Do preserve action bounds and keyboard focus when feedback changes.",
      "Do show Copied only after the clipboard write succeeds.",
      "Do keep settings labels visible and editor actions reachable below the scrolling form.",
      "Do treat native material, high contrast and physical-input behavior as pending platform verification."
    ],
    "donts": [
      "Don't add continuous or hidden-window animation.",
      "Don't rely on blur for contrast or distinguish status by color alone.",
      "Don't present browser component previews as native WPF or compositor evidence.",
      "Don't describe the prototype or its lightweight performance goal as ship-validated."
    ]
  }
}
