<Window x:Class="SableKit.Desktop.NetworkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SableKit.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="SableNet" Width="356" Height="454" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="20" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border Background="{DynamicResource PanelSurface}" CornerRadius="20" Padding="14,12,14,14">
 <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="28"/><RowDefinition/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <Grid MouseLeftButtonDown="DragHeader"><TextBlock x:Name="BrandTitle" Text="SableNet" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="PasteButton" Style="{StaticResource HeaderButton}" Content="&#xE77F;" ToolTip="Paste clipboard target" AutomationProperties.Name="Paste clipboard target" Click="PasteTarget"/>
   <Button x:Name="PinButton" Style="{StaticResource HeaderButton}" Content="&#xE718;" ToolTip="Pin · keep open" AutomationProperties.Name="Pin SableNet" Click="TogglePin"/>
   <Button Style="{StaticResource HeaderButton}" Content="&#xE8BB;" ToolTip="Close SableNet" AutomationProperties.Name="Close SableNet" Click="CloseTool"/>
  </StackPanel></Grid>
  <ComboBox x:Name="Candidates" Grid.Row="1" Tag="Choose detected address" DisplayMemberPath="Display" Visibility="Collapsed" Margin="0,6,0,6" AutomationProperties.Name="Choose detected address" SelectionChanged="ChooseCandidate"/>
  <StackPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock Text="Address" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="Target" AutomationProperties.Name="IP address or hostname" ToolTip="IP address or hostname" TextChanged="InputChanged"/></StackPanel>
  <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Port" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBox x:Name="Port" Grid.Column="1" AutomationProperties.Name="TCP port, optional" ToolTip="Optional. Leave blank for ping." TextChanged="InputChanged"/><Button x:Name="DnsButton" Grid.Column="2" Content="DNS" Margin="6,0,0,0" Padding="10,4" ToolTip="DNS or reverse lookup" Click="Dns"/></Grid>
  <WrapPanel x:Name="Ports" Grid.Row="4" Margin="0,7,0,3"/>
  <Grid Grid.Row="5"><TextBlock x:Name="Summary" Text="Ready" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,58,0" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="Elapsed" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
  <TextBox x:Name="Results" Grid.Row="6" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" VerticalContentAlignment="Top" BorderThickness="0" Padding="9" AutomationProperties.Name="Native command output"/>
  <Grid Grid.Row="7" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
   <Button x:Name="CheckButton" Content="Check connection" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Check"/>
   <Button x:Name="StopButton" Content="Stop" Click="Stop" Visibility="Collapsed"/>
   <Button x:Name="CopyButton" Grid.Column="1" Style="{StaticResource HeaderButton}" Content="&#xE8C8;" ToolTip="Copy output" AutomationProperties.Name="Copy output" Click="CopyResult" IsEnabled="False" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </Grid>
 </Grid></Border>
</Window>
