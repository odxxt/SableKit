<Window x:Class="SableKit.Desktop.NetworkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="SableNet" Width="510" Height="560" MinWidth="430" MinHeight="480" WindowStartupLocation="CenterScreen">
 <Border Background="{DynamicResource PanelSurface}" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="SableNet" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="A clear view of the connection." Foreground="{DynamicResource Muted}" Margin="0,7,0,22"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Target" AutomationProperties.Name="IP address or hostname, with optional port" ToolTip="IP address or hostname; optional :port"/><Button Grid.Column="1" Content="Paste" Margin="8,0,0,0" Click="PasteTarget" Style="{StaticResource FilledButton}"/></Grid>
  <StackPanel Grid.Row="2" Margin="0,12,0,16"><WrapPanel><Button x:Name="CheckButton" Content="Check connection" Style="{StaticResource PrimaryButton}" Click="Check" Margin="0,0,8,6"/><Button x:Name="DnsButton" Content="DNS lookup" Style="{StaticResource FilledButton}" Click="Dns" Margin="0,0,0,6"/></WrapPanel><WrapPanel x:Name="Ports"/></StackPanel>
  <Grid Grid.Row="3" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary" Text="Ready to check" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/><Button x:Name="StopButton" Grid.Column="1" Content="Stop" Click="Stop" Visibility="Collapsed"/></Grid>
  <TextBox x:Name="Results" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" VerticalContentAlignment="Top" AutomationProperties.Name="Network result" Text="Enter a target or paste one from the clipboard.&#10;&#10;An address uses ping. An explicit port tests TCP reachability.&#10;&#10;Later clipboard changes will not replace this target."/>
  <Grid Grid.Row="5" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="CopyButton" Content="Copy result" Click="CopyResult" Style="{StaticResource FilledButton}" IsEnabled="False"/><TextBlock x:Name="Elapsed" Grid.Column="2" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid>
 </Grid></Border>
</Window>
