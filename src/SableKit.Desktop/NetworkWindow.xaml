<Window x:Class="SableKit.Desktop.NetworkWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SableKit.Desktop" Style="{StaticResource {x:Type Window}}" Title="SableNet" Width="356" Height="454" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False">
 <Border Background="{DynamicResource Surface}" CornerRadius="20" Padding="16,12,16,16">
  <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="46"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="DragHeader"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:Icon Kind="network" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock x:Name="BrandTitle" Text="SableNet" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="PasteButton" Style="{StaticResource HeaderButton}" Content="&#xE77F;" ToolTip="Paste clipboard target" AutomationProperties.Name="Paste clipboard target" Click="PasteTarget"/>
    <Button x:Name="PinButton" Style="{StaticResource HeaderButton}" Content="&#xE718;" ToolTip="Pin · keep open" AutomationProperties.Name="Pin SableNet" Click="TogglePin"/>
    <Button Style="{StaticResource HeaderButton}" Content="&#xE8BB;" ToolTip="Close SableNet" AutomationProperties.Name="Close SableNet" Click="CloseTool"/>
   </StackPanel></Grid>
   <ComboBox x:Name="Candidates" Grid.Row="1" Tag="Choose detected address" DisplayMemberPath="Display" Visibility="Collapsed" Margin="0,6,0,6" AutomationProperties.Name="Choose detected address" SelectionChanged="ChooseCandidate"/>
   <Border Grid.Row="2" Background="{DynamicResource Inset}" CornerRadius="12" Padding="12,10" Margin="0,10,0,0"><StackPanel><TextBlock Text="Address" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,3"/><TextBox x:Name="Target" FontSize="16" Background="Transparent" BorderThickness="0" Padding="0,4" MinHeight="30" Tag="IP address or hostname" AutomationProperties.Name="IP address or hostname" TextChanged="InputChanged"/></StackPanel></Border>
   <Grid Grid.Row="3" Margin="0,10,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="TCP port" FontSize="12"/><TextBlock Text="Leave empty to ping" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="Port" Grid.Column="1" Tag="Optional" AutomationProperties.Name="TCP port, optional" ToolTip="1–65535. Leave empty for ping." TextChanged="InputChanged"/></Grid>
   <UniformGrid x:Name="Ports" Grid.Row="4" Rows="1" Margin="-3,0,-3,4"/>
   <Grid Grid.Row="5" Margin="0,9,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary" Text="Ready" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.LiveSetting="Polite"/><Button x:Name="DnsButton" Grid.Column="1" Content="DNS lookup" FontSize="11" Padding="6,2" MinHeight="28" ToolTip="DNS or reverse lookup" Click="Dns"/><Button x:Name="CopyButton" Grid.Column="2" Style="{StaticResource HeaderButton}" Content="&#xE8C8;" ToolTip="Copy output" AutomationProperties.Name="Copy output" Click="CopyResult" IsEnabled="False"/></Grid>
   <Grid Grid.Row="6"><TextBox x:Name="Results" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" VerticalContentAlignment="Top" BorderThickness="0" Padding="10" AutomationProperties.Name="Native command output"/><TextBlock x:Name="EmptyOutput" Text="Your check will appear here." Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
   <Grid Grid.Row="7" Margin="0,10,0,0"><Button x:Name="CheckButton" Content="Ping address" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Check"/><Button x:Name="StopButton" Content="Stop check" Click="Stop" Visibility="Collapsed"/><TextBlock x:Name="Elapsed" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="10" Foreground="{DynamicResource AccentText}" IsHitTestVisible="False"/></Grid>
  </Grid>
 </Border>
</Window>
