<Window x:Class="SableKit.Desktop.ActionEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Action settings" Width="800" Height="540" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize" ShowInTaskbar="False">
 <Border x:Name="Shell" Background="{DynamicResource Surface}" CornerRadius="20" Padding="22,10,22,20">
  <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="DragHeader"><TextBlock x:Name="EditorTitle" Text="Action settings" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Style="{StaticResource HeaderButton}" Content="&#xE8BB;" ToolTip="Close settings" AutomationProperties.Name="Close action settings" Click="CloseEditor"/></Grid>
   <ContentControl x:Name="EditorContent" Grid.Row="1" Margin="0,8,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="11" Margin="0,10,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
 </Border>
</Window>
