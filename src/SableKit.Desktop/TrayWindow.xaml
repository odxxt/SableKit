<Window x:Class="SableKit.Desktop.TrayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SableKit.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="SableKit quick actions" Width="336" Height="404" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False">

 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="16" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>

 <Border Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="15" Padding="15,10,15,12">

  <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="52"/><RowDefinition Height="37"/></Grid.RowDefinitions>

   <Grid MouseLeftButtonDown="DragHeader"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:Icon Kind="spark" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="SableKit" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="SearchButton" Style="{StaticResource IconButton}" ToolTip="Search actions (Ctrl+F)" AutomationProperties.Name="Search actions" Click="ToggleSearch"><local:Icon Kind="search"/></Button><Button x:Name="PinButton" Style="{StaticResource IconButton}" ToolTip="Pin · keep panel open" AutomationProperties.Name="Pin panel" Click="TogglePin"><local:Icon Kind="pin"/></Button><Button Style="{StaticResource IconButton}" ToolTip="Hide to tray (Esc)" AutomationProperties.Name="Hide panel" Click="HideClick"><local:Icon Kind="close"/></Button></StackPanel>

   </Grid>

   <TextBox x:Name="SearchBox" Tag="Find an action…" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,5" AutomationProperties.Name="Search actions and aliases" ToolTip="Search all actions and aliases" TextChanged="SearchChanged"/>

   <Button x:Name="Suggestion" Grid.Row="2" Visibility="Collapsed" HorizontalContentAlignment="Stretch" Style="{StaticResource FilledButton}" Padding="11,10" Margin="0,10,0,7" Click="RunSuggestion">

    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><local:Icon Kind="network" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock x:Name="SuggestionTitle" Text="Test connection" FontWeight="SemiBold"/><TextBlock x:Name="SuggestionTarget" Style="{StaticResource MutedText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><local:Icon Grid.Column="2" Kind="arrow" Width="15" Height="15" VerticalAlignment="Center"/></Grid>

   </Button>

   <Grid Grid.Row="3" Margin="0,5,0,0"><Grid.RowDefinitions><RowDefinition Height="29"/><RowDefinition/></Grid.RowDefinitions>

    <Grid><TextBlock x:Name="ActionsHeading" Text="Pinned actions" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><Button x:Name="ViewButton" HorizontalAlignment="Right" Style="{StaticResource IconButton}" AutomationProperties.Name="Switch pinned actions to grid" ToolTip="Switch pinned actions to grid" Click="ToggleView"><local:Icon x:Name="ViewIcon" Kind="grid" Width="14" Height="14"/></Button></Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><ItemsControl x:Name="ActionsList" KeyboardNavigation.TabNavigation="Continue"/><TextBlock x:Name="EmptyText" Text="No actions match. Try another name or alias." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="10,20" Visibility="Collapsed"/></StackPanel></ScrollViewer>

   </Grid>

   <Button Grid.Row="3" VerticalAlignment="Top" Height="29" Margin="0,5,34,0" x:Name="ResultButton" Visibility="Collapsed" HorizontalContentAlignment="Stretch" Padding="8,5" Click="OpenResult" ToolTip="Open the latest result"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions><TextBlock x:Name="ResultText" FontSize="11" TextTrimming="CharacterEllipsis"/><local:Icon Kind="expand" Width="12" Height="12" Grid.Column="1"/></Grid></Button>

   <Border Grid.Row="5" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,6,0,0"><UniformGrid Columns="3"><Button Click="OpenPasswords" ToolTip="Password defaults"><StackPanel Orientation="Horizontal"><local:Icon Kind="key" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Passwords" FontSize="11"/></StackPanel></Button><Button Click="OpenNetwork" ToolTip="Open SableNet"><StackPanel Orientation="Horizontal"><local:Icon Kind="network" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="SableNet" FontSize="11"/></StackPanel></Button><Button Click="OpenTools" ToolTip="Installed and planned tools"><StackPanel Orientation="Horizontal"><local:Icon Kind="grid" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="Tools" FontSize="11"/></StackPanel></Button></UniformGrid></Border>

   <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ProfilePicker" MinWidth="108" MaxWidth="205" FontSize="11" AutomationProperties.Name="Active profile" SelectionChanged="ProfileChanged"/><Button Grid.Column="2" Click="OpenMain" Padding="8,5" ToolTip="Open the main application"><StackPanel Orientation="Horizontal"><TextBlock Text="Open app" Style="{StaticResource MutedText}" Margin="0,0,7,0"/><local:Icon Kind="expand" Width="13" Height="13"/></StackPanel></Button></Grid>

  </Grid>

 </Border>

</Window>

