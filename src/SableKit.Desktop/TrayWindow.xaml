<Window x:Class="SableKit.Desktop.TrayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SableKit.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="SableKit quick actions" Width="342" Height="411" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False">
 <Border x:Name="Shell" Background="{DynamicResource PanelSurface}" BorderThickness="0" CornerRadius="20" Padding="14,12,14,14">
 <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="46"/></Grid.RowDefinitions>
  <Grid MouseLeftButtonDown="DragHeader"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="PanelTitle" Text="SableKit" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/><Button x:Name="SearchButton" Style="{StaticResource HeaderButton}" Content="&#xE721;" ToolTip="Search" AutomationProperties.Name="Search actions" Click="ToggleSearch"/><TextBox x:Name="SearchBox" Visibility="Collapsed" Width="142" MinHeight="30" Padding="6,4" Tag="Find an action" AutomationProperties.Name="Search actions and aliases" TextChanged="SearchChanged"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="PinButton" Style="{StaticResource HeaderButton}" Content="&#xE718;" ToolTip="Pin · keep open" AutomationProperties.Name="Pin panel" Click="TogglePin"/>
    <Button Style="{StaticResource HeaderButton}" Content="&#xE713;" ToolTip="Open SableKit" AutomationProperties.Name="Open main application" Click="OpenMain"/>
    <Button Style="{StaticResource HeaderButton}" Content="&#xE8BB;" ToolTip="Hide to tray" AutomationProperties.Name="Hide panel" Click="HideClick"/>
   </StackPanel>
  </Grid>
  <Button x:Name="Suggestion" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Inset}" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="12,9" Margin="0,4,0,8" Click="RunSuggestion">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions><local:Icon Kind="network" Width="16" Height="16" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock x:Name="SuggestionTitle" Text="Ping address" FontWeight="SemiBold"/><TextBlock x:Name="SuggestionTarget" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><local:Icon Grid.Column="2" Kind="arrow" Width="14" Height="14" VerticalAlignment="Center"/></Grid>
  </Button>
  <Grid x:Name="ActionsRegion" Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/></Grid.RowDefinitions>
   <Grid><TextBlock x:Name="ActionsHeading" Text="Pinned actions" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="ListViewButton" Style="{StaticResource HeaderButton}" ToolTip="List view" AutomationProperties.Name="Pinned actions list view" Click="ShowList"><local:Icon Kind="list" Width="15" Height="15"/></Button><Button x:Name="ViewButton" Style="{StaticResource HeaderButton}" ToolTip="Grid view" AutomationProperties.Name="Pinned actions grid view" Click="ShowGrid"><local:Icon x:Name="ViewIcon" Kind="grid" Width="15" Height="15"/></Button></StackPanel></Grid>
   <ScrollViewer x:Name="ActionScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><ItemsControl x:Name="ActionsList"/><TextBlock x:Name="EmptyText" Text="Pin actions from the main app." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="8,16" Visibility="Collapsed"/></StackPanel></ScrollViewer>
  </Grid>
  <Grid x:Name="ResultRegion" Grid.Row="3" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock x:Name="ResultTitle" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Style="{StaticResource HeaderButton}" Content="&#xE8BB;" ToolTip="Back to actions" AutomationProperties.Name="Back to actions" Click="DismissResult"/></Grid>
   <TextBox x:Name="ResultOutput" Grid.Row="1" FontFamily="Consolas" FontSize="10" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8" AutomationProperties.Name="Quick action output"/>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ResultStatus" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button x:Name="ResultButton" Grid.Column="1" Content="Open SableNet" FontSize="11" Padding="8,3" MinHeight="28" Click="OpenResult"/></Grid>
  </Grid>
  <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border}" Margin="0,5,0,0">
   <Grid x:Name="Footer" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
    <StackPanel x:Name="ToolStrip" Orientation="Horizontal" VerticalAlignment="Center"/>
    <Grid x:Name="ProfileStrip" Grid.Column="1" MouseWheel="ProfileWheel" ToolTip="Choose a profile, or scroll to switch">
     <Button x:Name="ProfileButton" BorderThickness="0" Padding="6,0" Click="ChooseProfile" PreviewKeyDown="ProfileKeys" AutomationProperties.Name="Active profile"><Grid Width="116"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions><local:Icon Kind="profiles" Width="13" Height="13" VerticalAlignment="Center"/><TextBlock x:Name="ProfileName" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" FontFamily="Segoe MDL2 Assets" FontSize="9" Text="&#xE70D;" VerticalAlignment="Center"/></Grid></Button>
     <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=ProfileButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True"><Border Background="{DynamicResource Inset}" CornerRadius="12" Padding="6" Width="186"><ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ProfileChoices"/></ScrollViewer></Border></Popup>
    </Grid>
   </Grid>
  </Border>
 </Grid></Border>
</Window>
