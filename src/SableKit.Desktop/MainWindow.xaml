<Window x:Class="SableKit.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SableKit.Desktop" Style="{StaticResource {x:Type Window}}" Title="SableKit" Width="1080" Height="720" MinWidth="900" MinHeight="610" WindowStartupLocation="CenterScreen">
 <Grid Background="{DynamicResource PanelSurface}"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="18,24,14,18"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="6,0,0,30"><StackPanel Orientation="Horizontal"><local:Icon Kind="spark" Width="23" Height="23" Margin="0,0,9,0"/><TextBlock Text="SableKit" FontWeight="SemiBold" FontSize="21"/></StackPanel><TextBlock Text="A little more capable." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Button Click="OpenPanel" HorizontalContentAlignment="Left" Padding="10,10"><StackPanel Orientation="Horizontal"><local:Icon Kind="expand" Width="16" Height="16" Margin="0,0,10,0"/><TextBlock Text="Quick panel"/></StackPanel></Button><TextBlock Text="Prototype 0.1" Style="{StaticResource MutedText}" Margin="10,12,0,0"/><TextBlock Text="Local. Portable. Yours." FontSize="10" Foreground="{DynamicResource Muted}" Margin="10,5,0,0"/></StackPanel>
   <StackPanel x:Name="Navigation"/>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,26,30,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Actions" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Small actions. Less repetition." Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" x:Name="AddButton" VerticalAlignment="Center" Content="+  New action" Style="{StaticResource PrimaryButton}" Padding="18,10" Click="AddAction"/></Grid>
   <ContentControl x:Name="PageContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,16,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
 </Grid>
</Window>
