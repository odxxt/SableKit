<Window x:Class="SableKit.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SableKit.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="SableKit" Width="920" Height="640" MinWidth="720" MinHeight="440" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="Manual">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid Background="{DynamicResource PanelSurface}">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="{DynamicResource Inset}">
   <TextBlock Text="SableKit" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="20,0,0,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,6,4" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="MinimizeButton" Style="{StaticResource HeaderButton}" Width="40" Height="32" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize window" Click="MinimizeWindow"/>
    <Button x:Name="MaximizeButton" Style="{StaticResource HeaderButton}" Width="40" Height="32" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize window" Click="MaximizeWindow"/>
    <Button x:Name="CloseButton" Style="{StaticResource HeaderButton}" Width="40" Height="32" Content="&#xE8BB;" ToolTip="Close window" AutomationProperties.Name="Close window" Click="CloseWindow"/>
   </StackPanel>
  </Grid>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="12,18,10,14"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="6,0,0,22"><StackPanel Orientation="Horizontal"><local:Icon Kind="spark" Width="23" Height="23" Margin="0,0,9,0"/><TextBlock Text="SableKit" FontWeight="SemiBold" FontSize="21"/></StackPanel><TextBlock Text="A little more capable." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Button Click="OpenPanel" HorizontalContentAlignment="Left" Padding="10,10"><StackPanel Orientation="Horizontal"><local:Icon Kind="expand" Width="16" Height="16" Margin="0,0,10,0"/><TextBlock Text="Quick panel"/></StackPanel></Button><TextBlock Text="Prototype 0.1.1" Style="{StaticResource MutedText}" Margin="10,12,0,0"/><TextBlock Text="Local. Portable. Yours." FontSize="10" Foreground="{DynamicResource Muted}" Margin="10,5,0,0"/></StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation"/></ScrollViewer>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="20,18,20,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Actions" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" TextWrapping="Wrap" Text="Small actions. Less repetition." Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" x:Name="AddButton" Margin="12,0,0,0" VerticalAlignment="Center" Content="+  New action" Style="{StaticResource PrimaryButton}" Padding="18,10" Click="AddAction"/></Grid>
   <ContentControl x:Name="PageContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,16,0,0" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
 </Grid>
 </Grid>
</Window>
